{{define "datagrid"}}
<table>
    <thead>
        <tr>
            {{range .Columns}}
            <th>
                {{ .Name }}
            </th>
            {{end}}
        </tr>
    </thead>

    <tbody>
        {{range .Rows}}
        {{$row := .}}
        <tr>
            {{range $i, $cell := .Cells}}
                {{$col := index $.Columns $i}}
                {{if $col.Editable}}
                <td>
                    <form>
                        <input name="RowID" type="hidden" value="{{$row.ID}}">
                        <input name="Column" type="hidden" value="{{$col.Name}}">
                        <textarea name="Value">{{$cell}}</textarea>
                        <button data-on:click="@patch('/api/dv-log/edit', {contentType: 'form'})">
                            Save
                        </button>
                    </form>
                </td>
                {{else}}
                <td>{{$cell}}</td>
                {{end}}
            {{end}}
        </tr>
        {{end}}
    </tbody>
</table>
{{end}}