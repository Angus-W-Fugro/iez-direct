{{define "datagrid"}}
<table>
    <thead>
        <tr>
            {{range .Columns}}
            <th>
                {{ .Name }}
            </th>
            {{end}}
        </tr>
    </thead>

    <tbody>
        {{range .Rows}}
        <tr>
            {{range .Cells}}
                <td>{{ . }}</td>
            {{end}}
        </tr>
        {{end}}
    </tbody>
</table>
{{end}}
